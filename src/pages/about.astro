---
import { getCollection } from "astro:content";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { authorSlug, getAllAuthors, visiblePosts } from "@/lib/posts";

const allPosts = visiblePosts(await getCollection("posts"));
const authors = getAllAuthors(allPosts);
---

<BaseLayout
  title="About"
  description={`About ${siteConfig.name} — what it publishes and who writes it.`}
>
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer">
    <div class="canvas">
      <header class="pagehead">
        <p class="eyebrow">About</p>
        <h2 class="pagehead-title">Əlaqə</h2>
      </header>

      <div class="prose">
        <p>Bizimlə əlaqə saxlayın – <strong>Cyberhub.az</strong> komandası hər zaman sizi dinləməyə və dəstək olmağa hazırdır.</p>
        <p>Bizimlə əlaqə saxlayın – <strong>Cyberhub.az</strong> komandası hər zaman sizi dinləməyə və dəstək olmağa hazırdır.</p>

        <h3>Sualınız, təklifiniz və ya əməkdaşlıq ideyanız var?</h3>
        <p>Texnologiya, kibertəhlükəsizlik və rəqəmsal innovasiyalar mövzusunda fikir paylaşmaq, rəy bildirmək və ya əməkdaşlıq imkanlarını müzakirə etmək istəyirsinizsə – doğru ünvandasınız!</p>

        <h3>Bizə necə çata bilərsiniz?</h3>
        <p>📧 <strong>E-poçt:</strong> <code>info@cyberkode.az</code></p>

        <h3>Əməkdaşlıq və sponsorluq</h3>
        <ul>
          <li>Saytımızda yer almaq istəyən texnologiya şirkətləri üçün <strong>sponsorlu məqalə</strong>, <strong>reklam bannerləri</strong>, və <strong>məhsul incələmələri</strong> xidmətlərimiz mövcuddur.</li>
          <li>Rəqəmsal təhlükəsizlik tədbirləri, seminar və vebinarlar üçün <strong>ortaq layihələrə</strong> açığıq.</li>
        </ul>
        <p>Əlavə məlumat üçün bizimlə əlaqə saxlayın, sizə tez bir zamanda geri dönüş ediləcək.</p>
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
