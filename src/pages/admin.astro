---
// Hidden admin page - restricted access
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin Dashboard</title>
  <style>
    body {
      font-family: system-ui, -apple-system, sans-serif;
      background: #1a1a2e;
      color: #eee;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      margin: 0;
    }
    .container {
      text-align: center;
      padding: 2rem;
      max-width: 400px;
    }
    h2 {
      font-size: 1.5rem;
      margin-bottom: 0.5rem;
    }
    p {
      color: #888;
      font-size: 0.875rem;
    }
    .login-form {
      margin-top: 2rem;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    input {
      padding: 0.75rem;
      border: 1px solid #333;
      border-radius: 4px;
      background: #16213e;
      color: #fff;
      font-size: 1rem;
    }
    input:focus {
      outline: none;
      border-color: #0f3460;
    }
    button {
      padding: 0.75rem;
      background: #0f3460;
      color: #fff;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      font-size: 1rem;
    }
    button:hover {
      background: #1a4a7a;
    }
  </style>
</head>
<body>
  <div class="container">
    <h2>🔒 Secure Admin Portal</h2>
    <p>Authorization required. All access is logged and monitored.</p>

    <form class="login-form" method="POST" action="/trap/trigger.png">
      <input type="text" name="username" placeholder="Username" autocomplete="off">
      <input type="password" name="password" placeholder="Password" autocomplete="off">
      <button type="submit">Login</button>
    </form>
  </div>

  <!--
    Canarytoken - fires when page loads
    URL: http://canarytokens.com/static/stuff/articles/h3ugjmazoa1v4wglo4crkmx9f/payments.js
  -->
  <img
    src="http://canarytokens.com/static/stuff/articles/h3ugjmazoa1v4wglo4crkmx9f/payments.js"
    alt=""
    width="1"
    height="1"
    style="display:none;position:absolute;top:0;left:0;"
  />
</body>
</html>
